{
  "name": "videojs-run",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "node apps/preview/deploy.mjs",
    "deploy:vercel": "pnpm dlx vercel@64 build && pnpm dlx vercel@64 deploy --prebuilt",
    "deploy:netlify": "pnpm dlx netlify-cli@27 deploy --build",
    "deploy:cloudflare": "pnpm run build && pnpm dlx wrangler@4 pages deploy dist --project-name run",
    "test:e2e": "playwright test",
    "site:dev": "pnpm --filter @run/site dev",
    "site:build": "pnpm --filter @run/site build",
    "site:stills": "node scripts/site-stills.mjs",
    "measure": "node scripts/measure.mjs",
    "film:fallback": "node scripts/film-fallback.mjs"
  },
  "dependencies": {
    "@videojs/html": "10.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@base-ui/react": "^1.6.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@videojs/mux-video": "10.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "postcss": "^8.5.33",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "description": "Run: a Video.js 10 skin that plays a film as an AI agent’s run. Chapters become the plan, captions the log, and the player shows its own reasoning.",
  "license": "Apache-2.0"
}
