---
/**
 * The page's head and body frame. Search engines are kept out until release: a build carries `noindex` unless it is
 * made with `SITE_INDEX=1`. The share picture is an absolute JPEG on the public origin (`site` in astro.config.mjs).
 */
import '@fontsource/fragment-mono/latin-400.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/site.css';
import { site } from '../content/copy';

const here = new URL(Astro.url.pathname, Astro.site);
const picture = new URL(site.image.path, Astro.site);
const indexed = process.env.SITE_INDEX === '1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    {!indexed && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={site.ink} />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={here} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={here} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.share} />
    <meta property="og:image" content={picture} />
    <meta property="og:image:width" content={String(site.image.width)} />
    <meta property="og:image:height" content={String(site.image.height)} />
    <meta property="og:image:alt" content={site.image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/site/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
